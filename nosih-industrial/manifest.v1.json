{
  "packId": "nosih-industrial-pack-v1",
  "schemaVersion": "1.0.0",
  "status": "preview",
  "category": "Agentic Industrial Control Protocol",
  "description": "Machine-readable Sprint 3 pack for factory-control schemas, policies, adapters, simulators, and example cells.",
  "scopeNote": "Adapter contract and conformance surface only. This pack does not claim live certified industrial execution.",
  "root": "nosih-industrial",
  "invariants": [
    "all_authorization_flows_through_policy_gateway",
    "adapters_translate_but_do_not_authorize",
    "simulation_receipt_required_for_physical_execution",
    "human_approval_required_for_T2_T3_execution",
    "execution_receipts_are_hash_linked",
    "settlement_requires_execution_receipt",
    "claims_remain_simulation_or_adapter_contract_until_real_partner_validation"
  ],
  "paths": {
    "schemas": "nosih-industrial/schemas",
    "policies": "nosih-industrial/policies",
    "adapters": "nosih-industrial/adapters",
    "simulators": "nosih-industrial/simulators",
    "settlement": "nosih-industrial/settlement",
    "examples": "nosih-industrial/examples"
  },
  "schemas": [
    {
      "id": "factory-intent",
      "packPath": "nosih-industrial/schemas/factory-intent.schema.json",
      "sourcePath": "docs/specs/factory-intent.schema.json",
      "object": "FactoryIntent"
    },
    {
      "id": "cell-graph",
      "packPath": "nosih-industrial/schemas/cell-graph.schema.json",
      "sourcePath": "docs/specs/cell-graph.schema.json",
      "object": "CellGraph"
    },
    {
      "id": "robot-action",
      "packPath": "nosih-industrial/schemas/robot-action.schema.json",
      "sourcePath": "docs/specs/robot-action.schema.json",
      "object": "RobotActionProfile"
    },
    {
      "id": "simulation-receipt",
      "packPath": "nosih-industrial/schemas/simulation-receipt.schema.json",
      "sourcePath": "docs/specs/simulation-receipt.schema.json",
      "object": "SimulationReceipt"
    },
    {
      "id": "factory-settlement",
      "packPath": "nosih-industrial/schemas/factory-settlement.schema.json",
      "sourcePath": "docs/specs/factory-settlement.schema.json",
      "object": "FactorySettlement"
    }
  ],
  "policies": [
    {
      "id": "industrial-policy",
      "packPath": "nosih-industrial/policies/industrial-policy.yaml",
      "sourcePath": "docs/specs/industrial-policy.yaml",
      "requires": [
        "simulation_receipt",
        "human_approval",
        "safety_zone_clear",
        "receipt_chain"
      ]
    }
  ],
  "settlementProfiles": [
    {
      "id": "factory-settlement",
      "status": "active-profile",
      "schemaPath": "nosih-industrial/schemas/factory-settlement.schema.json",
      "samplePath": "nosih-industrial/examples/pick-place-cell/factory-settlement.sample.json",
      "triggerEvent": "factory.execution.receipt",
      "settlementEvent": "factory.settlement.recorded",
      "requiredEvidence": [
        "simulationReceipt",
        "humanApproval",
        "factoryReceiptChain",
        "executionReceipt"
      ],
      "shareTotalBps": 10000,
      "paymentMethods": [
        "USDC",
        "x402",
        "invoice",
        "internal_credit",
        "none"
      ],
      "claimsExecutionAuthority": false
    }
  ],
  "adapters": [
    {
      "id": "ros2",
      "path": "nosih-industrial/adapters/ros2",
      "status": "active-profile",
      "protocol": "ros2",
      "policyResource": "ros2:///joint_commands",
      "actionSurface": "RobotActionProfile -> nosih_msgs/msg/FactoryRobotAction",
      "implementationRefs": [
        "packages/bridge-ros2/src/factory-action-profile.ts",
        "packages/bridge-ros2/src/ros2-resource-mapper.ts"
      ],
      "requiredEvidence": [
        "simulationReceipt",
        "humanApproval",
        "factoryReceiptChain",
        "forceVelocityEnvelope"
      ],
      "defaultTier": "T3_commit",
      "claimsLiveControl": false
    },
    {
      "id": "srci",
      "path": "nosih-industrial/adapters/srci",
      "status": "active-profile",
      "protocol": "srci",
      "policyResource": "ros2:///joint_commands",
      "actionSurface": "RobotActionProfile -> SRCI PickPlace command profile",
      "implementationRefs": [
        "packages/bridge-ros2/src/industrial-adapter-profiles.ts"
      ],
      "requiredEvidence": [
        "simulationReceipt",
        "humanApproval",
        "factoryReceiptChain",
        "plcInterlockState"
      ],
      "defaultTier": "T3_commit",
      "claimsLiveControl": false
    },
    {
      "id": "opcua",
      "path": "nosih-industrial/adapters/opcua",
      "status": "active-profile",
      "protocol": "opcua",
      "policyResource": "opcua://*/**",
      "actionSurface": "CellGraph asset and PLC method calls through OPC UA resource URIs",
      "implementationRefs": [
        "packages/bridge-opcua/src/opcua-resource-mapper.ts",
        "packages/conformance-tests/src/industrial-cell-safety-pack-conformance.test.ts"
      ],
      "requiredEvidence": [
        "simulationReceipt",
        "humanApproval",
        "factoryReceiptChain",
        "hardwareSafety"
      ],
      "defaultTier": "T2_act",
      "claimsLiveControl": false
    },
    {
      "id": "mqtt",
      "path": "nosih-industrial/adapters/mqtt",
      "status": "active-profile",
      "protocol": "mqtt",
      "policyResource": "mqtt://*/factory/**",
      "actionSurface": "Industrial telemetry, command staging, and gateway-mediated publish/subscribe",
      "implementationRefs": [
        "packages/bridge-iot/src/mqtt-session.ts",
