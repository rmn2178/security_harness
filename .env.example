# NOSIH Protocol — Environment Configuration
#
# Copy to .env and fill in your values.
# Railway auto-injects DATABASE_URL and REDIS_URL when using their services.

# ── Storage Backend ──
NOSIH_ENV=development          # "development", "test", or "production"
NOSIH_STORE=postgres           # "memory" or "postgres"
NOSIH_CACHE=redis              # "memory" or "redis"

# ── Database (required when NOSIH_STORE=postgres) ──
DATABASE_URL=postgresql://sint:sint@postgres:5432/sint

# ── Redis (required when NOSIH_CACHE=redis) ──
REDIS_URL=redis://redis:6379

# ── Gateway Server ──
NOSIH_PORT=3100
NOSIH_API_KEY=nosih-dev-key
NOSIH_REQUIRE_SIGNATURES=false
NOSIH_RATE_LIMIT=100
NOSIH_WS_ALLOW_QUERY_API_KEY=true

# ── Production gateway baseline ──
# Production mode fails closed unless these are set:
# NOSIH_ENV=production
# NOSIH_STORE=postgres
# NOSIH_CACHE=redis
# DATABASE_URL=postgresql://nosih:REDACTED@postgres:5432/nosih
# REDIS_URL=redis://redis:6379
# NOSIH_API_KEY=REDACTED
# NOSIH_REQUIRE_SIGNATURES=true
# NOSIH_WS_ALLOW_QUERY_API_KEY=false

# ── NOSIH MCP (optional) ──
# NOSIH_MCP_TRANSPORT=stdio    # "stdio" or "sse"
# NOSIH_MCP_PORT=3200
# NOSIH_MCP_POLICY=cautious    # "permissive", "cautious", "strict"
# NOSIH_MCP_APPROVAL_TIMEOUT=120000
# NOSIH_AGENT_PRIVATE_KEY=     # Auto-generated if unset
